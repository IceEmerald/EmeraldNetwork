# Content Security Policy - Prevent XSS and data injection attacks
# The site already has CSP implemented, but we reinforce it here
Content-Security-Policy: default-src 'self' data: https:; script-src 'self' 'unsafe-inline' https://*.google.com https://*.gstatic.com; style-src 'self' 'unsafe-inline' https://*.google.com https://*.gstatic.com; img-src 'self' data: https:; connect-src 'self' https:; font-src 'self' https://*.gstatic.com; frame-src 'self'; object-src 'none'; base-uri 'self';

# Protect against clickjacking attacks - prevent site from being embedded in iframes
X-Frame-Options: SAMEORIGIN

# Prevent MIME type sniffing - force browsers to respect the declared content type
X-Content-Type-Options: nosniff

# Enforce HTTPS connections with subdomain protection
Strict-Transport-Security: max-age=31556952; includeSubDomains; preload

# Control referrer information sent to other sites
Referrer-Policy: origin-when-cross-origin

# Control browser features and APIs
Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), vibrate=()